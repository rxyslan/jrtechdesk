#!/bin/bash

set -e

if [ "$1" = configure ]; then

	INITSYS=$(ls -al /proc/1/exe | awk -F' ' '{print $NF}' | awk -F'/' '{print $NF}')
	ln -f -s /usr/share/jrtechdesk/jrtechdesk /usr/bin/jrtechdesk

	if [ "systemd" == "$INITSYS" ]; then

		if [ -e /etc/systemd/system/jrtechdesk.service ]; then
			rm -f /etc/systemd/system/jrtechdesk.service /usr/lib/systemd/system/jrtechdesk.service /usr/lib/systemd/user/jrtechdesk.service >/dev/null  2>&1
		fi
		mkdir -p /usr/lib/systemd/system/
		cp /usr/share/jrtechdesk/files/systemd/jrtechdesk.service /usr/lib/systemd/system/jrtechdesk.service
		# try fix error in Ubuntu 18.04
		# Failed to reload jrtechdesk.service: Unit jrtechdesk.service is not loaded properly: Exec format error.
		# /usr/lib/systemd/system/jrtechdesk.service:10: Executable path is not absolute: pkill -f "jrtechdesk --"
		if [ -e /usr/bin/pkill ]; then
			sed -i "s|pkill|/usr/bin/pkill|g" /usr/lib/systemd/system/jrtechdesk.service
		fi
		systemctl daemon-reload
		systemctl enable jrtechdesk
		systemctl start jrtechdesk
	fi
fi
