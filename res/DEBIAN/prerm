#!/bin/bash

set -e

case $1 in
    remove|upgrade)
		INITSYS=$(ls -al /proc/1/exe | awk -F' ' '{print $NF}' | awk -F'/' '{print $NF}')
		rm -f /usr/bin/jrtechdesk
		
		if [ "systemd" == "${INITSYS}" ]; then

			# Numa atualização, lembra se o administrador desativou o serviço, para o
			# postinst da versão nova não reativá-lo.
			if [ "$1" = upgrade ] && ! systemctl is-enabled --quiet jrtechdesk 2>/dev/null; then
				mkdir -p /var/lib/jrtechdesk
				touch /var/lib/jrtechdesk/servico-desativado
			fi
			systemctl stop jrtechdesk || true
			systemctl disable jrtechdesk || true
			rm /etc/systemd/system/jrtechdesk.service /usr/lib/systemd/system/jrtechdesk.service || true
			
			# workaround temp dev build between 1.1.9 and 1.2.0
			serverUser=$(ps -ef | grep -E 'jrtechdesk +--server' | grep -v 'sudo ' | awk '{print $1}' | head -1)
			if [ "$serverUser" != "" ] && [ "$serverUser" != "root" ]
			then
				systemctl --machine=${serverUser}@.host --user stop jrtechdesk >/dev/null 2>&1 || true
			fi
			rm /usr/lib/systemd/user/jrtechdesk.service >/dev/null 2>&1 || true
		fi
        ;;
esac

exit 0
