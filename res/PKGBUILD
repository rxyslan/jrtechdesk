pkgname=jrtechdesk
pkgver=1.5.3
pkgrel=0
epoch=
pkgdesc="JrTechDesk - acesso remoto da JR Tech"
arch=('x86_64')
url="https://github.com/rxyslan/jrtechdesk"
license=('AGPL-3.0')
groups=()
depends=('gtk3' 'xdotool' 'libxcb' 'libxfixes' 'alsa-lib' 'libva' 'libappindicator-gtk3' 'gst-plugins-base' 'gst-plugin-pipewire')
makedepends=()
checkdepends=()
optdepends=()
provides=()
conflicts=()
replaces=()
backup=()
options=()
install=pacman_install
changelog=
noextract=()
md5sums=() #generate with 'makepkg -g'

package() {
  if [[ ${FLUTTER} ]]; then
	  mkdir -p "${pkgdir}/usr/share/jrtechdesk" && cp -r ${HBB}/flutter/build/linux/x64/release/bundle/* -t "${pkgdir}/usr/share/jrtechdesk"
  fi
  mkdir -p "${pkgdir}/usr/bin"
  pushd ${pkgdir} && ln -s /usr/share/jrtechdesk/jrtechdesk usr/bin/jrtechdesk && popd
  install -Dm 644 $HBB/res/jrtechdesk.service -t "${pkgdir}/usr/share/jrtechdesk/files"
  install -Dm 644 $HBB/res/jrtechdesk.desktop -t "${pkgdir}/usr/share/jrtechdesk/files"
  install -Dm 644 $HBB/res/jrtechdesk-link.desktop -t "${pkgdir}/usr/share/jrtechdesk/files"
  install -Dm 644 $HBB/res/128x128@2x.png "${pkgdir}/usr/share/icons/hicolor/256x256/apps/jrtechdesk.png"
  install -Dm 644 $HBB/res/scalable.svg "${pkgdir}/usr/share/icons/hicolor/scalable/apps/jrtechdesk.svg"
}
