# arg 1:  the new package version
post_install() {
	# do something here
	cp /usr/share/jrtechdesk/files/jrtechdesk.service /etc/systemd/system/jrtechdesk.service
	cp /usr/share/jrtechdesk/files/jrtechdesk.desktop /usr/share/applications/
	cp /usr/share/jrtechdesk/files/jrtechdesk-link.desktop /usr/share/applications/
	systemctl daemon-reload
	systemctl enable jrtechdesk
	systemctl start jrtechdesk
	update-desktop-database
}

# arg 1:  the new package version
# arg 2:  the old package version
pre_upgrade() {
    systemctl stop jrtechdesk || true
}

# arg 1:  the new package version
# arg 2:  the old package version
post_upgrade() {
	cp /usr/share/jrtechdesk/files/jrtechdesk.service /etc/systemd/system/jrtechdesk.service
	cp /usr/share/jrtechdesk/files/jrtechdesk.desktop /usr/share/applications/
	cp /usr/share/jrtechdesk/files/jrtechdesk-link.desktop /usr/share/applications/
	systemctl daemon-reload
	# Só volta a rodar se continuava habilitado: uma desativação do administrador vale.
	if systemctl is-enabled --quiet jrtechdesk; then
		systemctl start jrtechdesk
	fi
	update-desktop-database
}

# arg 1:  the old package version
pre_remove() {
	systemctl stop jrtechdesk || true
	systemctl disable jrtechdesk || true
	rm /etc/systemd/system/jrtechdesk.service || true
}

# arg 1:  the old package version
post_remove() {
	rm /usr/share/applications/jrtechdesk.desktop || true
	rm /usr/share/applications/jrtechdesk-link.desktop || true
	update-desktop-database
}
