# Site de download do JrTechDesk (CT 106).
baixar.desbloqueiorepidclass.com.br {
	# A validação HTTP-01 usa a porta 80. A porta 443 serve o site.
	tls {
		issuer acme {
			disable_tlsalpn_challenge
		}
	}

	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Content-Security-Policy "default-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		-Server
	}

	handle_path /download/* {
		root * /site/download
		header Cache-Control "no-cache"
		@instalador path *.exe *.deb *.zst
		header @instalador Content-Disposition attachment
		file_server
	}

	handle {
		root * /site/www
		file_server
	}
}
