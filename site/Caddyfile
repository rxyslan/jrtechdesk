# Site de download do JrTechDesk (CT 106). Caddy obtém e renova o HTTPS sozinho
# (Let's Encrypt), desde que as portas 80 e 443 cheguem até este servidor.
baixar.desbloqueiorepidclass.com.br {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Content-Security-Policy "default-src 'self'; style-src 'self'; script-src 'self'; img-src 'self'; connect-src 'self'; frame-ancestors 'none'"
		-Server
	}

	handle_path /download/* {
		root * /site/download
		header Cache-Control "no-cache"
		@instalador path *.exe *.deb *.zst
		header @instalador Content-Disposition attachment
		file_server
	}

	handle {
		root * /site/www
		file_server
	}
}
